#!/bin/sh /etc/rc.common
# shellcheck disable=SC2034,SC3043 # rc.common consumes these variables; BusyBox ash implements local.

START=95
STOP=10
USE_PROCD=1

WEB_KEY_FILE='/etc/magpie/secrets/web.key'

make_web_key() {
	local key
	# BusyBox od does not consistently accept the combined -An/-tx1
	# spelling; derive the key from a SHA-256 of 32 random bytes instead.
	key="$(dd if=/dev/urandom bs=32 count=1 2>/dev/null | sha256sum 2>/dev/null | awk '{print $1}')"
	case "$key" in
		*[!0-9a-f]*|'') key='' ;;
	esac
	if [ "${#key}" -ne 64 ]; then
		key="$(od -A n -N 32 -t x1 -v /dev/urandom 2>/dev/null | tr -d ' \n')"
	fi
	printf '%s' "$key"
}

# migrate_config upgrades the v1 UCI layout in place:
# - a wildcard gateway_addr is moved to loopback on the same port;
# - the long-term web key moves from UCI to the root-only secret file;
# - the removed web_addr option is deleted.
# It is idempotent and runs before config_load so the migrated values apply
# to this start.
migrate_config() {
	local changed=0 legacy_addr='' legacy_key='' port='' tmp=''

	legacy_addr="$(uci -q get magpie.main.gateway_addr 2>/dev/null)"
	case "$legacy_addr" in
		0.0.0.0:*|'*':*|'[::]':*)
			port="${legacy_addr##*:}"
			case "$port" in
				''|*[!0-9]*) ;;
				*)
					uci -q set "magpie.main.gateway_addr=127.0.0.1:$port"
					logger -t magpie "migrated legacy wildcard gateway_addr $legacy_addr to 127.0.0.1:$port; bind a specific LAN/VPN address if remote clients need it"
					changed=1
					;;
			esac
			;;
	esac

	legacy_key="$(uci -q get magpie.main.web_key 2>/dev/null)"
	if [ -n "$legacy_key" ]; then
		if [ ! -s "$WEB_KEY_FILE" ]; then
			case "$legacy_key" in
				*[!A-Za-z0-9._~-]*)
					logger -t magpie 'legacy Web Console key has invalid characters; a new key will be generated'
					;;
				*)
					if [ "${#legacy_key}" -ge 16 ]; then
						umask 077
						mkdir -p /etc/magpie/secrets || true
						tmp="${WEB_KEY_FILE}.migrate.$$"
						if printf '%s\n' "$legacy_key" > "$tmp" \
							&& chown root:root "$tmp" \
							&& chmod 0600 "$tmp" \
							&& mv -f "$tmp" "$WEB_KEY_FILE"; then
							chmod 0600 "$WEB_KEY_FILE" || true
							logger -t magpie 'migrated legacy Web Console key from UCI to the root-only secret file'
						else
							rm -f "$tmp" || true
							logger -t magpie 'failed to migrate legacy Web Console key; a new key will be generated'
						fi
					else
						logger -t magpie 'legacy Web Console key is too short; a new key will be generated'
					fi
					;;
			esac
		fi
		uci -q delete magpie.main.web_key
		changed=1
	fi

	if uci -q get magpie.main.web_addr >/dev/null 2>&1; then
		uci -q delete magpie.main.web_addr
		changed=1
	fi

	if [ "$changed" -eq 1 ]; then
		uci -q commit magpie
	fi
}

# is_unspecified_host rejects every spelling of an IPv4/IPv6 unspecified
# address that could otherwise bypass a literal string blacklist.
is_unspecified_host() {
	local host compact ipv4

	host="${1#[}"
	host="${host%]}"
	case "$host" in
		''|'*'|'::'|'::0'|'0:0:0:0:0:0:0:0')
			return 0
			;;
	esac
	case "$host" in
		*.*.*.*)
			if printf '%s\n' "$host" | awk -F. 'NF == 4 && $1 == 0 && $2 == 0 && $3 == 0 && $4 == 0 { exit 0 } { exit 1 }'; then
				return 0
			fi
			;;
	esac
	case "$host" in
		*:*)
			compact="$(printf '%s' "$host" | tr -d ':')"
			case "$compact" in
				''|*[!0]*) ;;
				*) return 0 ;;
			esac
			case "$host" in
				*[fF][fF][fF][fF]:*)
					ipv4="${host##*[fF][fF][fF][fF]:}"
					if printf '%s\n' "$ipv4" | awk -F. 'NF == 4 && $1 == 0 && $2 == 0 && $3 == 0 && $4 == 0 { exit 0 } { exit 1 }'; then
						return 0
					fi
					;;
			esac
			;;
	esac
	return 1
}

ensure_web_key() {
	local key tmp
	umask 077
	mkdir -p /etc/magpie/secrets || return 1
	chown root:root /etc/magpie /etc/magpie/secrets || return 1
	chmod 0711 /etc/magpie || return 1
	chmod 0700 /etc/magpie/secrets || return 1

	if [ ! -s "$WEB_KEY_FILE" ]; then
		key="$(make_web_key)"
		[ "${#key}" -eq 64 ] || {
			logger -t magpie 'failed to generate MAGPIE_WEB_KEY'
			return 1
		}
		tmp="${WEB_KEY_FILE}.$$"
		printf '%s\n' "$key" > "$tmp" || return 1
		chown root:root "$tmp" || return 1
		chmod 0600 "$tmp" || return 1
		mv -f "$tmp" "$WEB_KEY_FILE" || return 1
	fi

	# Re-assert permissions on every start, including after a manual restore.
	chown root:root "$WEB_KEY_FILE" || return 1
	chmod 0600 "$WEB_KEY_FILE" || return 1

	key="$(cat "$WEB_KEY_FILE" 2>/dev/null)"
	case "$key" in
		*[!A-Za-z0-9._~-]*|'')
			logger -t magpie 'web key file contains an invalid value'
			return 1
			;;
	esac
	[ "${#key}" -ge 16 ] || {
		logger -t magpie 'web key must contain at least 16 characters'
		return 1
	}
	WEB_KEY="$key"
}

start_service() {
	local enabled='' gateway_addr='' gateway_host='' gateway_port='' public_url='' data_dir=''

	migrate_config
	config_load magpie
	config_get enabled main enabled '1'
	[ "$enabled" = '1' ] || return 0

	config_get gateway_addr main gateway_addr '127.0.0.1:3425'
	config_get public_url main public_url ''
	config_get data_dir main data_dir '/etc/magpie'

	case "$data_dir" in
		/*) ;;
		*) logger -t magpie 'data_dir must be an absolute path'; return 1 ;;
	esac
	case "$data_dir" in
		*//*|*/./*|*/.|*/../*|*/..)
			logger -t magpie "refusing non-canonical data_dir: $data_dir"
			return 1
			;;
	esac
	case "$data_dir" in
		/|/etc|/etc/config|/etc/magpie/secrets|/etc/magpie/secrets/*|*/../*|*/..|/tmp|/var|/usr|/root|/overlay|/mnt|/rom|/proc|/sys|/dev)
			logger -t magpie "refusing unsafe data_dir: $data_dir"
			return 1
			;;
	esac
	case "$gateway_addr" in
		*:*)
			gateway_host="${gateway_addr%:*}"
			gateway_port="${gateway_addr##*:}"
			;;
		*) logger -t magpie 'gateway_addr must be host:port'; return 1 ;;
	esac
	case "$gateway_host" in
		'')
			logger -t magpie 'gateway_addr must include a host'
			return 1
			;;
		localhost)
			;;
		\[*:*\])
			;;
		*:*)
			logger -t magpie 'IPv6 gateway_addr must be written as [addr]:port'
			return 1
			;;
		*[!0-9.]*)
			logger -t magpie 'gateway_addr host must be an IPv4/IPv6 literal or localhost'
			return 1
			;;
	esac
	if is_unspecified_host "$gateway_host"; then
		logger -t magpie 'wildcard Gateway listeners are forbidden; bind to loopback or a specific LAN/VPN address'
		return 1
	fi
	case "$gateway_port" in
		''|*[!0-9]*) logger -t magpie 'gateway_addr must end with a numeric port'; return 1 ;;
	esac
	[ "$gateway_port" -ge 1 ] && [ "$gateway_port" -le 65535 ] || {
		logger -t magpie 'gateway_addr port must be between 1 and 65535'
		return 1
	}

	ensure_web_key || return 1

	umask 077
	mkdir -p "$data_dir" "$data_dir/home" "$data_dir/config" "$data_dir/data" \
		"$data_dir/state" /tmp/magpie/cache || return 1
	chown root:root "$data_dir" || return 1
	chmod 0711 "$data_dir" || return 1
	chown magpie:magpie "$data_dir/home" "$data_dir/config" \
		"$data_dir/data" "$data_dir/state" /tmp/magpie /tmp/magpie/cache || return 1
	chmod 0700 "$data_dir/home" "$data_dir/config" \
		"$data_dir/data" "$data_dir/state" /tmp/magpie /tmp/magpie/cache
	chmod 0700 /etc/magpie/secrets || return 1

	procd_open_instance
	procd_set_param command /usr/bin/magpie serve --web
	procd_set_param env \
		HOME="$data_dir/home" \
		XDG_CONFIG_HOME="$data_dir/config" \
		XDG_CACHE_HOME=/tmp/magpie/cache \
		XDG_DATA_HOME="$data_dir/data" \
		XDG_STATE_HOME="$data_dir/state" \
		MAGPIE_ADDR="$gateway_addr" \
		MAGPIE_WEB_KEY="$WEB_KEY" \
		MAGPIE_PUBLIC_URL="$public_url"
	procd_set_param user magpie
	procd_set_param group magpie
	procd_set_param respawn 3600 5 5
	# Upstream prints the Web Console link with ?k=<MAGPIE_WEB_KEY> on
	# startup, so stdout must not be relayed to syslog.
	procd_set_param stderr 1
	procd_close_instance
}

port_is_listening() {
	local port hex
	port="$1"
	case "$port" in
		''|*[!0-9]*) return 1 ;;
	esac
	[ "$port" -ge 1 ] && [ "$port" -le 65535 ] || return 1
	hex="$(printf '%04X' "$port")"
	awk -v p="$hex" '
		NR > 1 {
			split($2, endpoint, ":")
			if (toupper(endpoint[2]) == p && $4 == "0A") found = 1
		}
		END { exit(found ? 0 : 1) }
	' /proc/net/tcp /proc/net/tcp6 2>/dev/null
}

status() {
	local gateway_addr='' gateway_port=''
	if ! pidof magpie >/dev/null 2>&1; then
		echo 'stopped: Magpie process is not running'
		return 1
	fi

	config_load magpie
	config_get gateway_addr main gateway_addr '127.0.0.1:3425'
	case "$gateway_addr" in
		*:*) gateway_port="${gateway_addr##*:}" ;;
		*) echo 'degraded: invalid Gateway listen address'; return 1 ;;
	esac

	if ! port_is_listening "$gateway_port"; then
		echo "degraded: process exists but Gateway port ${gateway_port} is not listening"
		return 1
	fi
	if ! port_is_listening 3430; then
		echo 'degraded: Gateway listens but Web Console port 3430 is not listening'
		return 1
	fi

	echo 'healthy: process is running; Gateway and Web Console TCP listeners are available'
	return 0
}
